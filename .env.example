# Naik Foods - Environment Configuration Template
# Copy this file to .env and configure your keys

# Mappls (MapmyIndia) Web Maps SDK & REST API Key
# Sign up and generate a Web SDK / REST key at https://about.mappls.com/api/
VITE_MAPPLS_API_KEY=YOUR_MAPPLS_API_KEY

# Optional: Gemini AI Chatbot API Key
VITE_GEMINI_API_KEY=
